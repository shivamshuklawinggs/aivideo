# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/webtoon_explainer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=webtoon-storage

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRE=30d

# Sukuyami (Suwayomi Manga Server)
SUKUYAMI_GRAPHQL_URL=http://localhost:4567/api/graphql
SUKUYAMI_SOURCE_ID=all

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=llava

# XTTS Voice Cloning
XTTS_API_URL=http://localhost:8000

# Video Processing / Pipeline
FFMPEG_PATH=ffmpeg
VIDEO_OUTPUT_DIR=./storage/videos
TEMP_DIR=./temp
PANEL_BATCH_SIZE=5
PANEL_PARALLEL_REQUESTS=2
MAX_CONCURRENT_VIDEOS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
